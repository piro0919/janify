{
  "name": "janify",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secretlint": "secretlint --maskSecrets '**/*'",
    "typecheck": "next typegen && tsc --noEmit",
    "lefthook:install": "lefthook install",
    "wiki:artists": "tsx scripts/artists.ts",
    "wiki:albums": "tsx scripts/albums.ts",
    "notion:import": "tsx --env-file-if-exists=.env.local scripts/notion-import.ts",
    "youtube:channels": "tsx --env-file-if-exists=.env.local scripts/channels.ts",
    "youtube:videos": "tsx --env-file-if-exists=.env.local scripts/videos.ts",
    "youtube:match": "tsx scripts/match.ts",
    "notion:videos": "tsx --env-file-if-exists=.env.local scripts/notion-videos.ts",
    "notion:export": "tsx --env-file-if-exists=.env.local scripts/notion-export.ts",
    "youtube:unofficial": "tsx --env-file-if-exists=.env.local scripts/unofficial.ts",
    "test": "vitest run",
    "knip": "knip",
    "test:e2e": "playwright test",
    "lighthouse": "pnpm build && lhci autorun",
    "youtube:icons": "tsx --env-file-if-exists=.env.local scripts/channel-icons.ts",
    "youtube:check": "tsx --env-file-if-exists=.env.local scripts/check-videos.ts"
  },
  "dependencies": {
    "@bprogress/next": "^3.2.12",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vercel/analytics": "^2.0.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-ios-pwa-prompt": "^2.0.6",
    "server-only": "^0.0.1",
    "use-pwa": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@lhci/cli": "^0.16.0",
    "@piro0919/eslint-config": "github:piro0919/eslint-config#v1.1.0",
    "@playwright/test": "^1.65.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.45.1",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.0",
    "schema-dts": "^2.1.0",
    "secretlint": "^13.1.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.28.11"
}
